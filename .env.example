# ──────────────────────────────────────────────────────────────
# Sold Direct — environment template
# Copy to .env and fill with SANDBOX / TEST values only.
# NEVER commit real secrets. .env is gitignored.
# Keep this file in sync whenever a new config key is added.
# ──────────────────────────────────────────────────────────────

# --- API server ---
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Database (PostgreSQL / Supabase) — used from PR 2 (Prisma) ---
# Two URLs:
#   DATABASE_URL — runtime/pooled connection (Supabase pgBouncer, port 6543, add ?pgbouncer=true)
#   DIRECT_URL   — direct connection for migrations (Supabase, port 5432)
# Local dev: run a throwaway Postgres and point BOTH at it (no Supabase needed):
#   docker run -d --name selldirect-pg -e POSTGRES_PASSWORD=dev -p 5432:5432 postgres:16
DATABASE_URL=postgresql://postgres:dev@localhost:5432/sell_direct?schema=public
DIRECT_URL=postgresql://postgres:dev@localhost:5432/sell_direct?schema=public
# Deploy (Supabase) example — set these in the host dashboard, never in the repo:
#   DATABASE_URL=postgresql://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
#   DIRECT_URL=postgresql://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Supabase (managed Auth + Storage) — Auth used from PR 6, Storage when uploads land ---
# Service-role key is SERVER-SIDE ONLY — never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public (browser) values for the web dashboard auth:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- WhatsApp: choose your BSP ---
# Which provider the API talks WhatsApp through: "meta" (Cloud API direct) or
# "twilio". Business logic is provider-agnostic; this is the only switch.
WHATSAPP_BSP=meta

# --- WhatsApp via Meta Cloud API (direct) — WHATSAPP_BSP=meta ---
# Sandbox/test values only.
WHATSAPP_VERIFY_TOKEN=replace-with-your-own-random-verify-token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Graph API endpoint (override if a BSP proxies the Cloud API).
WHATSAPP_API_VERSION=v21.0
WHATSAPP_GRAPH_BASE=https://graph.facebook.com

# --- WhatsApp via Twilio — WHATSAPP_BSP=twilio ---
# From the Twilio Console. Sandbox/test values only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your WhatsApp sender, E.164 (e.g. +14155238886 for the sandbox). Prefer a
# Messaging Service SID in production (handles sender + templates + fallback).
TWILIO_WHATSAPP_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# The exact public webhook URL Twilio calls (used to validate its signature
# behind a proxy). Leave blank to reconstruct from forwarded headers.
TWILIO_WEBHOOK_URL=
# REST base (override only for tests).
TWILIO_API_BASE=https://api.twilio.com

# --- Approved WhatsApp templates (Twilio Content SIDs, HX…) ---
# Printed by `node scripts/twilio-templates.mjs` after approval submission.
# Leave blank until approved — the app falls back to plain session text.
TEMPLATE_WELCOME_CONSENT=
TEMPLATE_PREQUAL_INVITE=
TEMPLATE_PREQUAL_RESULT=
TEMPLATE_OTP_STATUS=
TEMPLATE_BOND_APPROVED=
TEMPLATE_FICA_CHECKLIST=
TEMPLATE_COMPLIANCE_CERTS=
TEMPLATE_TRANSFER_STATUS=
TEMPLATE_REENGAGEMENT=

# --- Bond originator referral (ooba) — used from PR 5 ---
# The hand-off is stubbed until a real partner integration is approved.
ORIGINATOR_REFERRAL_ENDPOINT=
ORIGINATOR_API_KEY=

# --- Encryption (POPIA: encrypt sensitive fields at rest) — used from PR 2 ---
# 32-byte key, base64-encoded. Generate locally; never commit a real key.
FIELD_ENCRYPTION_KEY=

# --- AI concierge (Claude) — modules/agent ---
# Drafts replies for WhatsApp messages no scripted flow claims. Off by default.
# AGENT_MODE=shadow (default): the agent only DRAFTS; a concierge approves from
#   the review queue (GET /api/agent/drafts, POST /api/agent/drafts/:id/approve)
#   and the user meanwhile gets the standard help reply.
# AGENT_MODE=live: replies send immediately; every turn is still audited in
#   agent_drafts. Flip only after reviewing real shadow transcripts.
AGENT_ENABLED=false
AGENT_MODE=shadow
ANTHROPIC_API_KEY=
# Optional overrides: model id and effort (low keeps WhatsApp latency snappy).
AGENT_MODEL=claude-opus-4-8
AGENT_EFFORT=low
# Listing-intake field extraction (no AI-authored text — it only reads):
# lets one reply fill several fields so the flow never re-asks a question.
# On automatically whenever ANTHROPIC_API_KEY is set; set INTAKE_EXTRACTION=false
# to force the strictly-scripted flow.
INTAKE_EXTRACTION=
INTAKE_EXTRACTOR_MODEL=claude-opus-4-8

# --- Web dashboard ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Public sites (marketing + fundraising) ---
# Server-side only: the public sites forward form submissions to the API
# internally (the browser never calls the API directly).
API_INTERNAL_URL=http://localhost:4000

# --- Internal dashboard (apps/web) ---
# When set, the API's read endpoints require this token; the dashboard sends it
# server-side. Leave blank locally to allow open reads in dev.
INTERNAL_API_TOKEN=
# Optional HTTP Basic Auth gate for the dashboard ("user:password").
# Leave blank locally; set on any deployed instance. (Supabase Auth is the
# production path; this is the MVP stand-in.)
DASHBOARD_BASIC_AUTH=
